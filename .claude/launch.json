{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "call-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "call:api"
      ],
      "port": 8787
    },
    {
      "name": "call-api-ingest",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "dev",
        "--local",
        "--port",
        "8787",
        "--config",
        "apps/call/wrangler.jsonc",
        "--var",
        "FEED_INGEST_TOKEN:local-dev"
      ],
      "port": 8787
    },
    {
      "name": "call-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "call:dev"
      ],
      "port": 5174,
      "autoPort": true
    }
  ]
}
